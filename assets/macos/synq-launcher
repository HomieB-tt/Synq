#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"

# Look for synq binary:
# 1. Inside the app bundle (self-contained)
if [ -x "$DIR/synq" ]; then
    CMD="$DIR/synq"
# 2. Next to the app bundle (in the same release folder)
elif [ -x "$DIR/../../synq" ]; then
    CMD="$DIR/../../synq"
# 3. Installed in PATH or common system directories
elif command -v synq >/dev/null 2>&1; then
    CMD="synq"
elif [ -x "/usr/local/bin/synq" ]; then
    CMD="/usr/local/bin/synq"
elif [ -x "/opt/homebrew/bin/synq" ]; then
    CMD="/opt/homebrew/bin/synq"
elif [ -x "$HOME/.local/bin/synq" ]; then
    CMD="$HOME/.local/bin/synq"
else
    osascript -e 'display alert "Synq Not Found" message "Could not find the synq executable. Please ensure synq is inside the app bundle, in the same directory, or installed on your PATH."'
    exit 1
fi

open -a Terminal "$CMD"
