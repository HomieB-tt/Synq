 	return m, tea.Batch(
 		startWSCmd(m.apiClient.BaseURL, m.accessToken),
 		uploadBoxKeySigCmd(m.apiClient, m.accessToken, m.identity, m.username),
@@ -165,6 +169,7 @@
 		m.fetchNodesCmd(),
 		m.fetchRoomsCmd(),
 		m.fetchFeedCmd(0),
+		latency,
 	)
 }
 
